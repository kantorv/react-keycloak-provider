{
  "name": "react-keycloak-provider",
  "version": "1.0.11",
  "private": false,
  "repository": "ssh+git@github.com:kantorv/react-keycloak-provider.git",
  "author": "Valentin Kantor",
  "license": "MIT",
  "main": "./build/index.js",
