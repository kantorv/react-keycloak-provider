  "license": "MIT",
  "main": "./build/index.js",
  "module": "./build/index.es.js",
  "types": "./build/index.d.ts",
  "files": [
    "build"
  ],
  "keywords": [
    "react",
    "typescript",
    "keycloak",
    "oidc"
